Options -Indexes

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8
  RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8
</IfModule>

<FilesMatch "\.(?:php|phtml|phar|php[0-9]?|cgi|pl|py|sh|bash|htaccess|user\.ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Disposition "inline"
</IfModule>
